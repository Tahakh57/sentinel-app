# Leave true to test locally without making Azure calls. Set false for live chat.
DEMO_MODE=true
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
# Your Azure deployment name, which may differ from its underlying model name.
AZURE_OPENAI_DEPLOYMENT=
# responses or chat; choose an API supported by your deployment.
AZURE_OPENAI_API=responses
AZURE_OPENAI_MAX_OUTPUT_TOKENS=800
